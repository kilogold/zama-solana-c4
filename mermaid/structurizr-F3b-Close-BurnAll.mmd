sequenceDiagram
  autonumber

  actor 1 as dApp user<br />[Person]
  participant 38 as @fhevm/confidential-token<br />[Container: TypeScript]
  participant 28 as @fhevm/sdk/solana<br />[Container: TypeScript]
  participant 37 as @fhevm/solana-zama-host<br />[Container: TypeScript]
  participant 3 as Solana cluster<br />[Software System]
  participant 16 as confidential-token<br />[Container: Anchor program]
  participant 21 as zama-fhe<br />[Container: Rust crate]
  participant 5 as zama-host<br />[Container: Anchor program]
  participant 49 as Decryption router<br />[Container: Rust]
  participant 51 as Endpoint<br />[Container: Rust]
  participant 52 as kms-worker Solana pipeline<br />[Container: Rust]
